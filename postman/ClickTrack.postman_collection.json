{
  "info": {
    "name": "ClickTrack",
    "description": "Test collection for ClickTrack API (Spring MVC XML config)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",     "value": "http://localhost:8080/clicktrack" },
    { "key": "publisherId", "value": "1" },
    { "key": "lienId",      "value": "1" },
    { "key": "trackingUrl", "value": "" }
  ],
  "item": [
    {
      "name": "01 - List publishers",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Content-Type is JSON', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "",
              "pm.test('Returns a non-empty array of publishers', function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.be.an('array').that.is.not.empty;",
              "    data.forEach(function (p) {",
              "        pm.expect(p).to.have.all.keys('id','nom','prenom','email','categorie');",
              "        pm.expect(p.categorie).to.be.oneOf(['INFLUENCEUR','YOUTUBEUR','BLOGEUR']);",
              "    });",
              "});",
              "",
              "// save first publisher id for later",
              "const list = pm.response.json();",
              "if (list.length > 0) {",
              "    pm.collectionVariables.set('publisherId', String(list[0].id));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/publishers",
          "host": ["{{baseUrl}}"],
          "path": ["api", "publishers"]
        }
      }
    },
    {
      "name": "02 - Create lien",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// unique offre name so every run creates a fresh lien",
              "const ts = Date.now();",
              "pm.variables.set('offreName', 'Offre test ' + ts);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Body has id, clicks = 0, correct offre', function () {",
              "    const lien = pm.response.json();",
              "    pm.expect(lien).to.have.property('id');",
              "    pm.expect(lien.clicks).to.eql(0);",
              "    pm.expect(lien.offre).to.eql(pm.variables.get('offreName'));",
              "    pm.expect(lien.publisherId).to.eql(Number(pm.collectionVariables.get('publisherId')));",
              "    pm.collectionVariables.set('lienId', String(lien.id));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"offre\": \"{{offreName}}\",\n  \"urlDestination\": \"https://www.example.com/casque-audio\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/publishers/{{publisherId}}/liens",
          "host": ["{{baseUrl}}"],
          "path": ["api", "publishers", "{{publisherId}}", "liens"]
        }
      }
    },
    {
      "name": "03 - List liens of publisher",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Array of liens with correct keys', function () {",
              "    const liens = pm.response.json();",
              "    pm.expect(liens).to.be.an('array');",
              "    liens.forEach(function (l) {",
              "        pm.expect(l).to.have.all.keys('id','offre','urlDestination','clicks','publisherId');",
              "        pm.expect(l.clicks).to.be.a('number').and.at.least(0);",
              "    });",
              "});",
              "",
              "// expose the clicks of our working lien to other requests",
              "const lienId = Number(pm.collectionVariables.get('lienId'));",
              "const all = pm.response.json();",
              "const mine = all.find(function (l) { return l.id === lienId; });",
              "if (mine) {",
              "    console.log('Working lien clicks =', mine.clicks);",
              "    pm.collectionVariables.set('lastClicks', String(mine.clicks));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/publishers/{{publisherId}}/liens",
          "host": ["{{baseUrl}}"],
          "path": ["api", "publishers", "{{publisherId}}", "liens"]
        }
      }
    },
    {
      "name": "04 - List offres of publisher",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Array of offres with correct keys', function () {",
              "    const offres = pm.response.json();",
              "    pm.expect(offres).to.be.an('array');",
              "    offres.forEach(function (o) {",
              "        pm.expect(o).to.have.all.keys('offre','nombreLiens','clicks');",
              "        pm.expect(o.nombreLiens).to.be.a('number').and.at.least(1);",
              "        pm.expect(o.clicks).to.be.a('number').and.at.least(0);",
              "    });",
              "});",
              "",
              "pm.test('Offre \"Casque audio X200\" aggregates correctly', function () {",
              "    const offres = pm.response.json();",
              "    const c = offres.find(function (o) { return o.offre === 'Casque audio X200'; });",
              "    if (c) {",
              "        pm.expect(c.clicks).to.be.at.least(1);",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/publishers/{{publisherId}}/offres",
          "host": ["{{baseUrl}}"],
          "path": ["api", "publishers", "{{publisherId}}", "offres"]
        }
      }
    },
    {
      "name": "05 - Track a click (JSON mode)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// ensure we hit the lien created in step 02",
              "if (!pm.collectionVariables.get('lienId')) {",
              "    pm.collectionVariables.set('lienId', '1');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Tracking payload shape', function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.have.all.keys('urlRedirection','publisher','offre','clicks');",
              "    pm.expect(data.urlRedirection).to.be.a('string').and.include('http');",
              "    pm.expect(data.publisher).to.be.a('string').and.not.empty;",
              "    pm.expect(data.offre).to.be.a('string').and.not.empty;",
              "    pm.expect(data.clicks).to.be.a('number').and.at.least(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/t/{{lienId}}",
          "host": ["{{baseUrl}}"],
          "path": ["t", "{{lienId}}"]
        }
      }
    },
    {
      "name": "06 - Track a click (302 redirect mode)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Only relevant if you implemented the bonus redirection",
              "pm.test('Status is 302', function () {",
              "    pm.response.to.have.status(302);",
              "});",
              "",
              "pm.test('Location header points to urlDestination', function () {",
              "    const loc = pm.response.headers.get('Location');",
              "    pm.expect(loc).to.be.a('string');",
              "    pm.expect(loc).to.include('https://www.example.com');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/t/{{lienId}}",
          "host": ["{{baseUrl}}"],
          "path": ["t", "{{lienId}}"]
        }
      }
    },
    {
      "name": "07 - 404 on unknown lien",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 404 Not Found', function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/t/999999",
          "host": ["{{baseUrl}}"],
          "path": ["t", "999999"]
        }
      }
    },
    {
      "name": "CONCURRENCY - Check total clicks",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const lienId = Number(pm.collectionVariables.get('lienId'));",
              "const expected = Number(pm.collectionVariables.get('expectedClicks') || 0);",
              "const all = pm.response.json();",
              "const mine = all.find(function (l) { return l.id === lienId; });",
              "",
              "pm.test('Lien found', function () {",
              "    pm.expect(mine, 'lien ' + lienId + ' not found').to.exist;",
              "});",
              "",
              "if (mine) {",
              "    console.log('Clicks for lien', lienId, '=', mine.clicks, '(expected', expected + ')');",
              "    pm.test('No click lost (clicks >= expected)', function () {",
              "        pm.expect(mine.clicks).to.be.at.least(expected);",
              "    });",
              "    pm.test('No click duplicated (clicks == expected)', function () {",
              "        pm.expect(mine.clicks).to.eql(expected);",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/publishers/{{publisherId}}/liens",
          "host": ["{{baseUrl}}"],
          "path": ["api", "publishers", "{{publisherId}}", "liens"]
        }
      }
    }
  ]
}